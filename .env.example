# Токен бота от @BotFather
TG_BOT_TOKEN=

# Ваш числовой Telegram ID. Можно не указывать: при первом запуске бот
# напечатает в консоли ссылку привязки, и владельцем станет тот, кто её откроет.
TG_OWNER_ID=

# Прокси, если Telegram / VK недоступны напрямую (http://… или socks5://…)
TG_PROXY=
VK_PROXY=

# Пересылать ли ваши собственные сообщения из выбранных чатов
FORWARD_OUTGOING=false

# Раз в сколько секунд сверять чаты с ВК (страховка поверх long poll)
POLL_INTERVAL=60

# Раз в сколько секунд проверять стены сообществ, добавленных командой /add
WALL_POLL_INTERVAL=300

DATA_DIR=./data
LOG_LEVEL=INFO
